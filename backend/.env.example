# Copy this file to .env and fill in the values. Never commit .env.

# Gemini
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# The account the app uses. scripts/setup_db.py creates it with
# read-only (SELECT) access. Use a password of at least 12 characters.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_data_analyst
DB_USER=querygenie_ro
DB_PASSWORD=choose_a_strong_password

# Admin account, used only by scripts/setup_db.py to create the database,
# tables, sample data and the read-only user. Don't set these on a server.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your_mysql_root_password

# Frontend URLs allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
