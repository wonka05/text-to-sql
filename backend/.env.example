# Copy this file to .env and fill in the values. Never commit .env.
# Real environment variables override anything in this file.

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=your_api_key_here
# Google's recommended model for new projects. gemini-2.5-flash is cheaper but
# only available to API keys that have used it before.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_SECONDS=25

# --- Database the app reads ------------------------------------------------
# scripts/setup_db.py creates DB_USER with read-only (SELECT) access.
# Use a password of at least 12 characters.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_data_analyst
DB_USER=querygenie_ro
DB_PASSWORD=choose_a_strong_password
# Cloud MySQL only: the server's CA certificate (file path or pasted PEM text)
# turns on an encrypted, verified connection. Leave unset for a local MySQL.
# DB_SSL_CA=C:\path\to\ca.pem
# DB_SSL_VERIFY_HOSTNAME=true

# Admin account, used only by scripts/setup_db.py to create the database,
# tables, sample data and the read-only user. Don't set these on a server.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your_mysql_root_password

# --- Query limits -----------------------------------------------------------
# MAX_RESULT_ROWS=500
# QUERY_TIMEOUT_SECONDS=5
# Columns the app may never read, as table.column pairs, e.g.
# RESTRICTED_COLUMNS=employees.salary,customers.phone

# --- AI pipeline --------------------------------------------------------------
# How many times a failed query is sent back to the model with the error (0-3)
# MAX_REPAIR_ATTEMPTS=1
# SCHEMA_CACHE_SECONDS=300
# Remembered model replies for repeated questions (0 turns caching off)
# GENERATION_CACHE_SIZE=128

# --- API --------------------------------------------------------------------
# Frontend URLs allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
# Requests per minute per client IP to /query and /sql (0 turns it off)
# RATE_LIMIT_PER_MINUTE=20
# LOG_LEVEL=INFO
